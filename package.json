{
  "name": "angular-dashboard1",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npx ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test:dev": "ng test",
    "test": "ng test --browsers ChromeHeadless --code-coverage",
    "electron": "electron .",
    "electron-dev": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "electron-build": "ng build && electron-builder",
    "electron-build-win": "ng build && electron-builder -win --x64",
    "electron-build-mac": "ng build && electron-builder --mac",
    "electron-build-linux": "ng build && electron-builder -linux --x64"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "dexie": "^4.2.1",
    "rxdb": "^17.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/platform-browser-dynamic": "^21.2.8",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.19.3",
    "concurrently": "^9.2.1",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "postcss": "^8.5.13",
    "uuid": "^14.0.0",
    "launch-editor": "^2.9.0",
    "vite": "^6.3.6",
    "webpack-dev-server": ">=5.2.6",
    "tar": "^7.4.0",
    "undici": "^7.28.0",
    "minimatch": "^11.0.0",
    "glob": "^14.0.2",
    "http-proxy-middleware": "^3.0.7",
    "piscina": "^5.3.1",
    "esbuild": "^0.28.0",
    "@babel/core": "^7.29.13"
  },
  "main": "main.js",
  "build": {
    "appId": "com.yourdomain.app",
    "productName": "Dashboard App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/icon.icns"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
